POSTGRES_USER=ponto
POSTGRES_PASSWORD=ponto
POSTGRES_DB=ponto_digital
POSTGRES_PORT=5432

DATABASE_URL="postgresql://ponto:ponto@localhost:5432/ponto_digital?schema=public"

PORT=3050
ORIGIN=http://localhost:3050

JWT_SECRET="segredo123"

# URL pública usada para montar o link de recuperação de senha (cai em ORIGIN se ausente)
APP_URL=http://localhost:3050

# SMTP (recuperação de senha). Sem SMTP_HOST, o link é apenas logado no console (dev).
# Ex.: Mailtrap sandbox para testar sem domínio verificado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ponto Digital <no-reply@pontodigital.app>"

# Certificado do REP (.p12/PFX) — assina o comprovante (PDF) e gera o .p7s
# (CAdES destacado) do AFD e do AEJ. Dev: `npm run generate:cert`.
# Produção: certificado ICP-Brasil (e-CNPJ A1) do empregador. Onde só dá para
# guardar segredo em texto (Render), use COMPROVANTE_CERT_BASE64 com a saída de
# `base64 -w0 arquivo.p12` — tem prioridade sobre COMPROVANTE_CERT_PATH.
# Sem certificado (ou SKIP_SIGN=true), AFD/AEJ saem só em .txt, sem assinatura.
COMPROVANTE_STORAGE_PATH=./storage/comprovantes
COMPROVANTE_CERT_BASE64=
COMPROVANTE_CERT_PATH=./certs/rep-dev.p12
COMPROVANTE_CERT_PASS=dev123
COMPROVANTE_ASSINANTE_NOME="GestaoPontoDigital - REP Eletrônico"
COMPROVANTE_SKIP_SIGN=false

# Identificação do REP-P / PTRP nos arquivos legais (AFD e AEJ). Placeholders:
# preencher com os dados reais (registro no INPI e desenvolvedor) antes do uso real.
AFD_REP_INPI=00000000000000000
AFD_REP_DEV_TIPO=1
AFD_REP_DEV_INSCRICAO=00000000000000
PTRP_NOME="OnTime - Controle de Jornada Digital"
PTRP_VERSAO=0.1.0
PTRP_DESENV_RAZAO="OnTime Sistemas"
PTRP_DESENV_EMAIL=contato@ontime.dev

# Hora legal (Portaria 671/2021): diferença do relógio do servidor para a Hora
# Legal Brasileira via SNTP (UDP 123). Diagnóstico em Admin > Auditoria.
# HORA_LEGAL_SERVIDORES=a.st1.ntp.br,b.st1.ntp.br,c.st1.ntp.br,d.st1.ntp.br
