generator client {
  provider = "prisma-client"
  output   = "../src/lib/server/prisma-client"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model Empresa {
  id                 String    @id @default(cuid())
  nome               String
  cnpj               String?   @unique
  // Dados cadastrais do empregador para o AFD (Portaria 671/2021).
  razaoSocial        String?   @map("razao_social")
  caepfCno           String?   @map("caepf_cno") // CAEPF ou CNO, quando existir
  localPrestacao     String?   @map("local_prestacao") // local de prestação de serviços (tipo 2)
  // Contador da sequência de NSR do REP (por empresa/estabelecimento). Incrementado
  // atomicamente a cada evento (batida tipo 7, empregador tipo 2, empregado tipo 5).
  ultimoNsr          BigInt    @default(0) @map("ultimo_nsr")
  // Setting da empresa; `<input type="time">` no admin já garante o formato "HH:MM".
  // Mantido como String de propósito: `@db.Time` viraria Date (data fantasma) e
  // exigiria conversão frágil com timezone para um campo de baixo risco.
  horaAbertura       String    @map("hora_abertura") // "08:00"
  horaFechamento     String    @map("hora_fechamento") // "18:00"
  // Banco de horas (art. 59 da CLT). Regime: "nenhum" | "mensal" (§6º, compensa no
  // mês) | "semestral" (§5º, acordo individual) | "anual" (§2º, convenção coletiva).
  // Os ciclos contam a partir de `bancoHorasInicio`; no vencimento o saldo positivo
  // é pago como extra e o negativo é zerado ou descontado (`bancoHorasNegativo`).
  bancoHorasRegime   String    @default("nenhum") @map("banco_horas_regime")
  bancoHorasInicio   DateTime? @map("banco_horas_inicio") @db.Date
  bancoHorasNegativo String    @default("zerar") @map("banco_horas_negativo") // "zerar" | "descontar"
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  usuarios          Usuario[]
  colaboradores     Colaborador[]
  jornadas          Jornada[]
  departamentos     Departamento[]
  registros         Registro[]
  ausencias         Ausencia[]
  eventosEmpregador EventoEmpregador[]
  eventosEmpregado  EventoEmpregado[]
  eventosSensiveis  EventoSensivel[]
  comprovantes      Comprovante[]
  feriados          Feriado[]
  locaisTrabalho    LocalTrabalho[]

  @@map("empresas")
}

// Identidade autenticável — ÚNICA entidade de login (admin e colaborador).
// `role` marca o acesso de gestão; "é colaborador / bate ponto" é dado pela
// existência da extensão `Colaborador` vinculada. Uma pessoa pode ter os dois
// (ex.: RH que gerencia e bate ponto = role='admin' + linha em colaboradores).
model Usuario {
  id        String   @id @default(cuid())
  empresaId String   @map("empresa_id")
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome      String
  email     String
  cpf       String
  senhaHash String   @map("senha_hash")
  role      String // "admin" | "colaborador"
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Extensão 1:1 opcional com o vínculo de emprego.
  colaborador Colaborador?

  // Back-relations dos campos de auditoria (quem fez a ação).
  registrosCriados    Registro[]                  @relation("registroCriadoPor")
  anulacoes           RegistroAnulacao[]          @relation("anulacaoAnuladoPor")
  anulacoesRevertidas RegistroAnulacaoRevertida[] @relation("anulacaoRevertidaPor")
  ausenciasRevisadas  Ausencia[]                  @relation("ausenciaRevisadoPor")
  ajustesEscala       EscalaAjuste[]              @relation("escalaAjusteCriadoPor")

  @@unique([empresaId, email])
  @@unique([empresaId, cpf])
  @@index([empresaId])
  @@map("usuarios")
}

// Colaborador — extensão 1:1 da identidade com os dados de vínculo de emprego.
// NÃO guarda credencial: login mora só em `usuarios`. `usuarioId` amarra a
// identidade autenticável correspondente.
model Colaborador {
  id             String          @id @default(cuid())
  usuarioId      String          @unique @map("usuario_id")
  usuario        Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresaId      String          @map("empresa_id")
  empresa        Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cargo          String?
  departamentoId String?         @map("departamento_id")
  departamento   Departamento?   @relation(fields: [departamentoId], references: [id], onDelete: SetNull)
  telefone       String?
  dataAdmissao   DateTime?       @map("data_admissao") @db.Timestamptz(6)
  status         String? // "ativo" | "inativo" | "ferias" | "afastado"
  jornadaId      String?         @map("jornada_id")
  jornada        Jornada?        @relation(fields: [jornadaId], references: [id], onDelete: SetNull)
  registros      Registro[]
  ausencias      Ausencia[]
  escalasFeriado FeriadoEscala[]
  escalaCiclos   EscalaCiclo[]
  escalaAjustes  EscalaAjuste[]
  // Soft delete — Portaria 671/2021: demitir um colaborador não pode apagar o
  // histórico de ponto. Registros das leituras "ativas" filtram `deletedAt: null`;
  // relatórios legais (espelho) ainda alcançam demitidos.
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([empresaId])
  @@index([empresaId, deletedAt])
  @@map("colaboradores")
}

model Departamento {
  id            String        @id @default(cuid())
  empresaId     String        @map("empresa_id")
  empresa       Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome          String
  colaboradores Colaborador[]
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([empresaId, nome])
  @@index([empresaId])
  @@map("departamentos")
}

model Jornada {
  id            String          @id @default(cuid())
  empresaId     String          @map("empresa_id")
  empresa       Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome          String
  colaboradores Colaborador[]
  // Versões do horário ao longo do tempo (vigência). O cálculo de datas passadas
  // resolve qual versão estava vigente no dia — alterar o horário não reescreve o histórico.
  versoes       JornadaVersao[]
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([empresaId])
  @@map("jornadas")
}

// Versão de horário de uma Jornada, válida a partir de `vigenciaInicio`.
// Versões já vigentes são imutáveis (histórico). Alteração de horário cria uma
// versão vigente a partir do dia seguinte; ver PUT /api/jornadas/[id].
model JornadaVersao {
  id             String   @id @default(cuid())
  jornadaId      String   @map("jornada_id")
  jornada        Jornada  @relation(fields: [jornadaId], references: [id], onDelete: Cascade)
  // JSON com os 7 dias (segunda..domingo)
  dias           Json
  vigenciaInicio DateTime @map("vigencia_inicio") @db.Date
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([jornadaId, vigenciaInicio])
  @@index([jornadaId, vigenciaInicio])
  @@map("jornada_versoes")
}

// Registro de ponto (batida) — imutável conforme Portaria 671/2021.
model Registro {
  id            String      @id @default(cuid())
  colaboradorId String      @map("colaborador_id")
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Restrict)
  empresaId     String      @map("empresa_id")
  empresa       Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipo          String // "entrada" | "saida_almoco" | "retorno_almoco" | "saida"
  marcadoEm     DateTime    @default(now()) @map("marcado_em") @db.Timestamptz(6)
  metodo        String // "manual"
  // AFD tipo 7 (Portaria 671/2021): identificação e integridade da marcação.
  // `cpf` = snapshot do CPF de quem bateu (congela a identidade: editar o CPF do
  // usuário depois não reescreve o histórico nem quebra a cadeia de hash).
  // `registradoEm` = data-hora da gravação (distinta de `marcadoEm` em batida retroativa).
  cpf           String
  registradoEm  DateTime    @default(now()) @map("registrado_em") @db.Timestamptz(6)
  // Fonte da marcação (campo fonteMarc do AEJ): "O" = marcação original do REP
  // (feita pelo trabalhador; recebe NSR + hash-chain e entra no AFD); "I" = incluída
  // manualmente pelo empregador no tratamento (sem NSR/hash, fora do AFD — só
  // aparece no AEJ com o motivo). CHECK no banco garante o par fonte × NSR/hash.
  fonte         String      @default("O")
  nsr           BigInt?     @map("nsr")
  hash          String?
  hashAnterior  String?     @map("hash_anterior")

  criadoPor           String?                     @map("criado_por")
  criadoPorRef        Usuario?                    @relation("registroCriadoPor", fields: [criadoPor], references: [id], onDelete: Restrict)
  criadoMotivo        String?                     @map("criado_motivo")
  anulacao            RegistroAnulacao?           @relation("registroAnulado")
  substituiAnulacao   RegistroAnulacao?           @relation("registroSubstituto")
  anulacoesRevertidas RegistroAnulacaoRevertida[]

  comprovante Comprovante? @relation("registro_comprovante")

  // Geolocalização da batida (ver `src/lib/server/geolocalizacao.ts`). Snapshot
  // gravado no momento da marcação: editar ou desativar o local depois não reescreve
  // o histórico. Não entra no AFD nem no hash. `localizacao`: "dentro" | "fora" |
  // "sem_localizacao" | "sem_locais"; null = anterior ao recurso ou inclusão do admin.
  latitude        Float?
  longitude       Float?
  precisaoM       Int?           @map("precisao_m")
  localizacao     String?
  localTrabalhoId String?        @map("local_trabalho_id")
  localTrabalho   LocalTrabalho? @relation(fields: [localTrabalhoId], references: [id], onDelete: Restrict)
  distanciaM      Int?           @map("distancia_m")

  @@unique([empresaId, nsr])
  @@index([colaboradorId, marcadoEm])
  @@index([empresaId, marcadoEm])
  @@map("registros")
}

// Anulação de registro — complementa um Registro invalidando-o sem apagá-lo.
// Cálculo do espelho ignora registros com anulacao; AFD legal exporta ambos.
// Ajuste = anulação com `registroSubstitutoId` apontando para a batida corrigida.
// Anulação avulsa (ex.: clique duplicado) tem `registroSubstitutoId` nulo.
model RegistroAnulacao {
  id                   String    @id @default(cuid())
  registroId           String    @unique @map("registro_id")
  registro             Registro  @relation("registroAnulado", fields: [registroId], references: [id], onDelete: Cascade)
  registroSubstitutoId String?   @unique @map("registro_substituto_id")
  registroSubstituto   Registro? @relation("registroSubstituto", fields: [registroSubstitutoId], references: [id], onDelete: SetNull)
  empresaId            String    @map("empresa_id")
  motivo               String
  anuladoPor           String    @map("anulado_por") // Usuario.id do admin
  anuladoPorRef        Usuario   @relation("anulacaoAnuladoPor", fields: [anuladoPor], references: [id], onDelete: Restrict)
  anuladoEm            DateTime  @default(now()) @map("anulado_em") @db.Timestamptz(6)

  @@index([empresaId])
  @@map("registro_anulacoes")
}

// Histórico das anulações avulsas revertidas. Reverter tira a linha de
// `registro_anulacoes` (a batida volta a contar), mas antes a copia para cá: o
// trigger `diario_somente_insercao` só deixa apagar uma anulação que já tenha a
// cópia gravada. Append-only, como o resto do diário.
model RegistroAnulacaoRevertida {
  id              String   @id @default(cuid())
  anulacaoId      String   @unique @map("anulacao_id") // id da linha que saiu de registro_anulacoes
  registroId      String   @map("registro_id")
  registro        Registro @relation(fields: [registroId], references: [id], onDelete: Restrict)
  empresaId       String   @map("empresa_id")
  motivo          String // motivo da anulação original
  anuladoPor      String   @map("anulado_por")
  anuladoEm       DateTime @map("anulado_em") @db.Timestamptz(6)
  revertidoPor    String   @map("revertido_por")
  revertidoPorRef Usuario  @relation("anulacaoRevertidaPor", fields: [revertidoPor], references: [id], onDelete: Restrict)
  revertidoEm     DateTime @default(now()) @map("revertido_em") @db.Timestamptz(6)

  @@index([registroId])
  @@index([empresaId])
  @@map("registro_anulacoes_revertidas")
}

// Evento de inclusão/alteração do empregador no REP (AFD tipo 2). Append-only:
// cada mudança cadastral relevante da empresa gera um novo evento com NSR próprio,
// preservando o histórico exigido pela Portaria 671/2021.
model EventoEmpregador {
  id             String   @id @default(cuid())
  empresaId      String   @map("empresa_id")
  empresa        Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nsr            BigInt   @map("nsr")
  registradoEm   DateTime @default(now()) @map("registrado_em") @db.Timestamptz(6)
  cpfResponsavel String   @map("cpf_responsavel") // CPF do admin que fez a inclusão/alteração
  inscricaoTipo  String   @map("inscricao_tipo") // "1" CNPJ | "2" CPF
  inscricao      String // CNPJ ou CPF do empregador (só dígitos)
  caepfCno       String?  @map("caepf_cno")
  razaoSocial    String   @map("razao_social")
  localPrestacao String?  @map("local_prestacao")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([empresaId, nsr])
  @@index([empresaId, nsr])
  @@map("eventos_empregador")
}

// Evento de inclusão/alteração/exclusão de empregado no REP (AFD tipo 5). Append-only,
// com NSR próprio na mesma sequência das batidas. `operacao`: I | A | E.
model EventoEmpregado {
  id             String   @id @default(cuid())
  empresaId      String   @map("empresa_id")
  empresa        Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nsr            BigInt   @map("nsr")
  registradoEm   DateTime @default(now()) @map("registrado_em") @db.Timestamptz(6)
  operacao       String // "I" inclusão | "A" alteração | "E" exclusão
  cpfEmpregado   String   @map("cpf_empregado")
  nomeEmpregado  String   @map("nome_empregado")
  cpfResponsavel String   @map("cpf_responsavel")
  colaboradorId  String?  @map("colaborador_id") // vínculo lógico (não FK — sobrevive a exclusão)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([empresaId, nsr])
  @@index([empresaId, nsr])
  @@map("eventos_empregado")
}

// Evento sensível do REP (AFD tipo 6). Append-only, com NSR próprio na mesma
// sequência das batidas. Para REP-P: "07" disponibilidade e "08" indisponibilidade
// de serviço (início/parada do servidor); "02" retorno de energia não se aplica à nuvem.
model EventoSensivel {
  id           String   @id @default(cuid())
  empresaId    String   @map("empresa_id")
  empresa      Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nsr          BigInt   @map("nsr")
  registradoEm DateTime @default(now()) @map("registrado_em") @db.Timestamptz(6)
  tipoEvento   String   @map("tipo_evento") // "02" | "07" | "08"

  @@unique([empresaId, nsr])
  @@index([empresaId, nsr])
  @@map("eventos_sensiveis")
}

model Comprovante {
  id             String    @id @default(cuid())
  registroId     String    @unique @map("registro_id")
  registro       Registro  @relation("registro_comprovante", fields: [registroId], references: [id], onDelete: Restrict)
  empresaId      String    @map("empresa_id")
  empresa        Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  colaboradorId  String    @map("colaborador_id")
  nsr            BigInt    @map("nsr")
  caminhoArquivo String    @map("caminho_arquivo")
  hashSha256     String    @map("hash_sha256")
  geradoEm       DateTime  @default(now()) @map("gerado_em") @db.Timestamptz(6)
  enviadoEm      DateTime? @map("enviado_em") @db.Timestamptz(6)
  envioStatus    String    @default("pendente") @map("envio_status")
  envioErro      String?   @map("envio_erro")

  @@index([empresaId, geradoEm])
  @@index([colaboradorId, geradoEm])
  @@index([envioStatus])
  @@map("comprovantes")
}

// Ausência / afastamento — unifica férias, atestados e folgas sob um único
// fluxo de aprovação. `tipo` discrimina a natureza; `status` rege a aprovação.
model Ausencia {
  id             String      @id @default(cuid())
  colaboradorId  String      @map("colaborador_id")
  colaborador    Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  empresaId      String      @map("empresa_id")
  empresa        Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipo           String // "ferias" | "atestado" | "folga" | "outro"
  dataInicio     DateTime    @map("data_inicio") @db.Timestamptz(6)
  dataFim        DateTime    @map("data_fim") @db.Timestamptz(6)
  motivo         String?
  anexoUrl       String?     @map("anexo_url")
  status         String      @default("pendente") // "pendente" | "aprovada" | "rejeitada"
  revisadoPor    String?     @map("revisado_por") // Usuario.id do admin que revisou
  revisadoPorRef Usuario?    @relation("ausenciaRevisadoPor", fields: [revisadoPor], references: [id], onDelete: Restrict)
  revisadoEm     DateTime?   @map("revisado_em") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([empresaId])
  @@index([colaboradorId])
  @@index([status])
  @@map("ausencias")
}

// Feriado ou ponto facultativo da empresa. Os feriados nacionais são fixos em lei
// e calculados em `src/lib/server/feriado/calendario.ts`: só ganham linha aqui
// (abrangencia "nacional") quando a empresa abre no dia e precisa guardar a escala.
//
// Na apuração o dia é sem expediente — sem falta nem déficit — para quem não está
// na escala; quem está escalado segue a própria jornada.
model Feriado {
  id          String          @id @default(cuid())
  empresaId   String          @map("empresa_id")
  empresa     Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  data        DateTime        @db.Timestamptz(6) // data pura (meia-noite UTC), como Ausencia
  nome        String
  tipo        String          @default("feriado") // "feriado" | "ponto_facultativo"
  abrangencia String          @default("municipal") // "nacional" | "estadual" | "municipal"
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  escala      FeriadoEscala[]

  @@unique([empresaId, data])
  @@map("feriados")
}

// Quem trabalha no feriado/ponto facultativo (a empresa pode abrir com equipe reduzida).
model FeriadoEscala {
  feriadoId     String      @map("feriado_id")
  feriado       Feriado     @relation(fields: [feriadoId], references: [id], onDelete: Cascade)
  colaboradorId String      @map("colaborador_id")
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  @@id([feriadoId, colaboradorId])
  @@index([colaboradorId])
  @@map("feriado_escalas")
}

// Escala de folga — ciclo de trabalho/folga do colaborador (ver
// `src/lib/server/escala/calendario.ts`). `sequencia` é "T"/"F" por dia a partir
// da vigência ("TTTTTTF" = 6x1, "TF" = 12x36); null volta ao padrão semanal da
// jornada. Versionado por vigência, como a jornada: mudar a escala não reescreve
// o histórico.
model EscalaCiclo {
  id             String      @id @default(cuid())
  colaboradorId  String      @map("colaborador_id")
  colaborador    Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  vigenciaInicio DateTime    @map("vigencia_inicio") @db.Date
  sequencia      String?
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([colaboradorId, vigenciaInicio])
  @@map("escala_ciclos")
}

// Exceção pontual da escala num dia: trabalha (true) ou folga (false). Trocar a
// folga de terça para quinta são dois ajustes.
model EscalaAjuste {
  colaboradorId String      @map("colaborador_id")
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  data          DateTime    @db.Date
  trabalha      Boolean
  motivo        String?
  criadoPor     String      @map("criado_por") // Usuario.id do admin
  criadoPorRef  Usuario     @relation("escalaAjusteCriadoPor", fields: [criadoPor], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([colaboradorId, data])
  @@map("escala_ajustes")
}

// Local de trabalho para a conferência da geolocalização da batida: ponto + raio.
// A batida vale em qualquer local ativo da empresa; fora de todos ela entra do
// mesmo jeito e é sinalizada (art. 74 da Portaria 671 veda restringir a marcação).
model LocalTrabalho {
  id        String     @id @default(cuid())
  empresaId String     @map("empresa_id")
  empresa   Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome      String
  latitude  Float
  longitude Float
  raioM     Int        @default(150) @map("raio_m")
  ativo     Boolean    @default(true)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  registros Registro[]

