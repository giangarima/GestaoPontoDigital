{
	"name": "ponto-digital",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node build",
		"start:prod": "prisma migrate deploy && node build",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"lint": "eslint .",
		"test": "vitest run --project unit",
		"test:db": "docker compose --profile test up -d --wait postgres-test && vitest run --project db",
		"test:all": "npm run test && npm run test:db",
		"format": "prettier --write .",
		"prepare": "husky",
		"postinstall": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:seed": "tsx prisma/seed.ts",
		"db:studio": "prisma studio",
		"db:reset": "prisma migrate reset --force && tsx prisma/seed.ts",
		"generate:cert": "node scripts/generate-dev-cert.mjs"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,css,md}": [
			"prettier --write"
		]
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@types/bcryptjs": "^2.4.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^25.9.4",
		"@types/node-forge": "^1.3.14",
		"@types/nodemailer": "^8.0.1",
		"@types/pg": "^8.20.0",
		"dotenv": "^17.4.2",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.16.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.55.1",
		"svelte-check": "^4.4.6",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.58.0",
		"vite": "^6.2.7",
		"vitest": "^3.2.7"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"@signpdf/placeholder-pdf-lib": "^3.3.0",
		"@signpdf/signer-p12": "^3.0.0",
		"@signpdf/signpdf": "^3.0.0",
		"bcryptjs": "^3.0.3",
		"fflate": "^0.8.3",
		"jsonwebtoken": "^9.0.3",
		"node-forge": "^1.3.1",
		"nodemailer": "^9.0.3",
		"pdf-lib": "^1.17.1",
		"pg": "^8.21.0",
		"prisma": "^7.8.0",
		"puppeteer": "^24.0.0",
		"zod": "^4.4.3"
	}
}
